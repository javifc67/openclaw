[Unit]
Description=Psycholinguistics Web Portal Service
After=network.target

[Service]
Type=simple
# NOTE: Customize the WorkingDirectory path if you cloned the repository in a different directory or system locale.
# For English system locales (default): WorkingDirectory=%h/Desktop/openclaw/portal_web
# For Spanish system locales: WorkingDirectory=%h/Escritorio/openclaw/portal_web
WorkingDirectory=%h/Desktop/openclaw/portal_web
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=HOME=%h
Environment=PATH=/usr/bin:%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/bin

# Logs are captured automatically by journald.
# You can inspect logs with: journalctl --user -u psycholinguistics-portal.service -f

[Install]
WantedBy=default.target
