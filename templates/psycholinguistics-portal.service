[Unit]
Description=Psycholinguistics Web Portal Service
After=network.target

[Service]
Type=simple
# NOTE: Update the WorkingDirectory to match the path where you clone this repository.
WorkingDirectory=%h/Escritorio/psycholinguistics_deployment/portal_web
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# Output and error log files
StandardOutput=append:%h/Escritorio/psycholinguistics_deployment/portal_web/server.log
StandardError=append:%h/Escritorio/psycholinguistics_deployment/portal_web/server.log

[Install]
WantedBy=default.target
